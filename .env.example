# ============================================================
#  HorusAPI – environment variables
#  Copy this file to .env and fill in all values before running.
#  NEVER commit .env to version control.
# ============================================================

# ── Domain & TLS (Let's Encrypt) ─────────────────────────────
# The public domain name for this server.
# An A record must point to this machine's IP before first start.
DOMAIN=vpn.example.com

# Email used for Let's Encrypt registration and expiry alerts.
CERTBOT_EMAIL=admin@example.com

# Set to 1 to terminate TLS with a Let's Encrypt cert (HTTP redirects to HTTPS).
# Set to 0 to serve plain HTTP on port 80 only — no certbot, no redirect.
USE_SSL=0

# Set to 1 to use the Let's Encrypt STAGING environment (safe for testing,
# issues untrusted certs). Only relevant when USE_SSL=1.
CERTBOT_STAGING=0

# Origin used to build password-reset links in outgoing e-mail.
# Leave empty to use https://${DOMAIN}; set it explicitly when USE_SSL=0
# (e.g. http://vpn.example.com) or when the app is behind another host name.
PUBLIC_URL=

# ── Client downloads (release mirror) ─────────────────────────
# nginx mirrors the newest release of this repo into /download and serves the
# installers itself — the site never links to github.com.
RELEASE_REPO=Ov3rl0rd1/Horus-Release

# 1 = also mirror pre-releases (current v0.1.0 is one), 0 = stable only.
RELEASE_INCLUDE_PRERELEASE=1

# How often (seconds) the container re-checks GitHub for a newer release.
RELEASE_SYNC_INTERVAL=3600

# Optional GitHub token — only raises the API rate limit (60/h per IP without
# one, which is plenty for hourly checks). Leave empty for public repos.
GITHUB_TOKEN=

# ── Outbound mail (Postfix container) ─────────────────────────
# Confirmation codes and reset links are sent from no-reply@mail.${DOMAIN}.
# For them to reach inboxes, ${DOMAIN} needs SPF/DKIM/DMARC records and the
# server needs a matching PTR record.
# Set to false to log codes/links to the API log instead of sending them —
# handy for local testing without a working mail setup.
MAIL_ENABLED=true

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=horus
POSTGRES_USER=horus
POSTGRES_PASSWORD=replace-with-strong-password

# ── Payments (Platega) ────────────────────────────────────────
# Acquirer credentials from your Platega dashboard. Keep these OUT of git.
# The webhook must be configured in Platega's dashboard to point at
#   https://${DOMAIN}/payments/platega/webhook
# (public HTTPS with a valid certificate — HTTP/self-signed are rejected).
Payments__Provider=platega
Payments__Platega__BaseUrl=https://app.platega.io/
Payments__Platega__MerchantId=
Payments__Platega__Secret=
# Where the payer lands after a one-time payment (v2). Defaults to ${PUBLIC_URL}/cabinet?paid=1|0.
Payments__Platega__ReturnUrl=
Payments__Platega__FailedUrl=
# How long a checkout holds a node slot before it's swept back (minutes; ~= Platega's pay window).
Payments__HoldMinutes=30
# How often the background sweeper releases expired holds (minutes).
Payments__SweepMinutes=5

# ── Encrypted DB backups (backup sidecar) ─────────────────────
# See docs/backups.md. Off by default. To enable:
#   1) generate an age keypair OFF this server:  age-keygen -o horus-backup.key
#      (keep horus-backup.key safe elsewhere — it's the ONLY way to decrypt/restore)
#   2) put its public line (age1...) in AGE_RECIPIENT below
#   3) copy backup/rclone.conf.example → backup/rclone.conf and fill in R2/B2 creds
#   4) set BACKUP_ENABLED=true and create the bucket named in RCLONE_REMOTE
BACKUP_ENABLED=false
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
AGE_RECIPIENT=
RCLONE_REMOTE=r2:horus-backups
