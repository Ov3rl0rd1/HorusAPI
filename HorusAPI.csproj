<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7d92df17-88fc-4b8c-ae40-5451fac2e7a5</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <ServerGarbageCollection>false</ServerGarbageCollection>

    <!-- The test project lives in a subfolder of this (root) project, so keep its
         sources out of this project's default **/*.cs globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);HorusAPI.Tests/**</DefaultItemExcludes>

    <!-- Dapper.AOT emits its interceptors into this namespace; enable the feature. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>

    <!-- Local OpenAPI spec: written to ./openapi/HorusAPI.json on every build.
         Purely a local artifact — nothing is served publicly (see OpenApiSetup).
         Skipped inside the Docker build so the container image stays lean. -->
    <OpenApiDocumentsDirectory Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' != 'true'">$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOnBuild Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' == 'true'">false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Dapper" Version="2.1.72" />
    <!-- Compile-time Dapper command/materializer generation + column↔member diagnostics.
         Opted in per-class with [DapperAot] on the AOT-friendly services. NOTE: this
         package has a REQUIRED runtime assembly (Dapper.AOT.dll) that the generated
         interceptors call into — do NOT set PrivateAssets=all / mark it dev-only, or
         `dotnet publish` drops the DLL and every intercepted query throws
         FileNotFoundException at runtime. The DAP005 notice this analyzer raises in
         the test project is silenced there via <NoWarn> instead. -->
    <PackageReference Include="Dapper.AOT" Version="1.0.52" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <!-- Pin above the transitive 2.0.0 that Microsoft.AspNetCore.OpenApi pulls in:
         2.0.0 has a high-severity advisory (GHSA-v5pm-xwqc-g5wc) and is deprecated.
         Stay on the 2.x line — 3.x breaks the built-in generator's source generator
         (read-only IOpenApiMediaType.Example). 2.11.0 is the latest patched 2.x. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.5">
      <IncludeAssets>build; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <!-- ADO.NET driver used directly with Dapper (was previously pulled in only
         transitively via the now-removed EF Core PostgreSQL provider). -->
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <!-- UI only. The built-in Microsoft.AspNetCore.OpenApi generates the document;
         this package (no Microsoft.OpenApi dependency of its own) just renders it
         locally. The full Swashbuckle metapackage would drag in a SwaggerGen that
         pins an incompatible Microsoft.OpenApi. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.7" />
  </ItemGroup>

</Project>
