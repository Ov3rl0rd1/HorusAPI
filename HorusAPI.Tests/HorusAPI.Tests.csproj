<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- This project only consumes HorusAPI; it never emits its own OpenAPI file. -->
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <!-- Dapper.AOT's analyzer flows in transitively and notes that our test-only
         Dapper calls aren't AOT-enabled (DAP005). Intentional — tests stay classic. -->
    <NoWarn>$(NoWarn);DAP005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Lets integration tests Skip (not fail) when no PostgreSQL is reachable. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HorusAPI.csproj" />
  </ItemGroup>

  <!-- The integration fixture applies the real schema to a throwaway database. -->
  <ItemGroup>
    <Content Include="..\init.sql" Link="init.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
