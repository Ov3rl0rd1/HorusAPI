# ── Telegram ──────────────────────────────────────────────────────────────────
# Create the bot with @BotFather, then send it any message and read the chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates. For a group, add the bot
# to the group first — group ids are negative (e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Scrape credentials ────────────────────────────────────────────────────────
# The same value goes into METRICS_TOKEN on every monitored host. It is
# read-only and intentionally NOT the node control password: this box must be
# able to read telemetry and never to provision or delete a user.
# Generate with: openssl rand -hex 24
# Stored in vm/secrets/metrics_password (git-ignored), not here — see README.

# ── Retention ─────────────────────────────────────────────────────────────────
# 30 days of the whole fleet costs roughly 100-300 MB after compression, so the
# 7 days you asked for is not worth the saving. Lower it if the box is tiny.
RETENTION=30d

# ── Web access: HTTPS + Telegram Mini App ─────────────────────────────────────
# The name the monitoring is opened by. Its DNS A record must point at THIS
# server, and ports 80 and 443 must be open: Caddy gets and renews the Let's
# Encrypt certificate by itself on first start.
MONITOR_DOMAIN=monitor.example.com

# Who may open it from Telegram: numeric user ids, comma-separated. Your own id:
# write anything to the bot, then look at message.from.id in
# https://api.telegram.org/bot<TOKEN>/getUpdates (or ask @userinfobot).
# A person, not a group: group ids are negative and are refused.
TG_ALLOWED_USERS=

# Access from an ordinary browser (a form), and from scripts as
# `Authorization: Bearer <key>`. Empty = Telegram only.
# Generate with: openssl rand -hex 32
ACCESS_KEY=

# The bot's menu button that opens the monitoring. It is set automatically, and
# only in the chats of TG_ALLOWED_USERS — nobody else sees it. Each of them must
# have pressed Start in the bot once. Empty = leave the bot's menu alone.
TG_MENU_BUTTON=Мониторинг

# Session lifetimes, hours. Telegram logs in again on every launch by itself, so
# its sessions can be short at no cost; a key has to be typed.
SESSION_HOURS_TG=12
SESSION_HOURS_KEY=720

# Change to any new value and run `docker compose up -d gate` to log everyone
# out. Rotating ACCESS_KEY does the same.
SESSION_SALT=

# Remote write for ru-probe over the same HTTPS (optional). Empty = route off.
# Generate with: openssl rand -hex 24
PROBE_PASSWORD=

# ── Direct VictoriaMetrics port ───────────────────────────────────────────────
# VictoriaMetrics itself has NO authentication; the web goes through Caddy above.
# Keep 127.0.0.1: this port is the way in over an SSH tunnel when the web one is
# broken — ssh -L 8428:127.0.0.1:8428 root@<monitoring-host>. Never 0.0.0.0.
VM_BIND=127.0.0.1
VM_PORT=8428

# ── Sizing ────────────────────────────────────────────────────────────────────
# VM sizes its caches from total host RAM; on a 1 GB VPS that is too generous.
VM_MEMORY_PERCENT=40
VM_MEM_LIMIT=512M
EVAL_INTERVAL=30s

# ── Image tags ────────────────────────────────────────────────────────────────
VM_TAG=v1.111.0
AM_TAG=v0.28.1
NE_TAG=v1.8.2
CADDY_TAG=2.10-alpine
PY_TAG=3.13-alpine
