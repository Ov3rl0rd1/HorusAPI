# ============================================================
#  HorusAPI – environment variables
#  Copy this file to .env and fill in all values before running.
#  NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=horus
POSTGRES_USER=horus
POSTGRES_PASSWORD=replace-with-strong-password

# ── JWT ───────────────────────────────────────────────────────
# Minimum 64 characters. Generate with:  openssl rand -base64 64
Jwt__Secret=replace-with-min-64-char-random-secret
Jwt__Issuer=horus-auth-api
Jwt__Audience=horus-clients
Jwt__ExpiryMinutes=60

# ── Socks5 defaults for config rendering ──────────────────────
Socks5__Port=1080
Socks5__Username=replace-me
Socks5__Password=replace-me

# ── TLS certificates ──────────────────────────────────────────
# Path on the HOST where Hysteria2 stores its Let's Encrypt certs.
# The directory is mounted read-only inside the container at /certs.
# Common Hysteria2 cert locations:
#   /etc/hysteria/          (default config dir)
#   /etc/letsencrypt/live/<domain>/   (certbot-managed)
CERT_DIR=/etc/hysteria
