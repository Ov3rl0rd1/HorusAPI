# Куда пушить: веб-адрес монитор-сервера (MONITOR_DOMAIN в его .env), без порта.
# Запись идёт через тот же HTTPS, что и веб-доступ; порт VictoriaMetrics наружу
# не открыт.
MONITOR_URL=https://monitor.example.com

# Пароль — PROBE_PASSWORD из .env монитор-сервера. Имя пользователя не
# проверяется, оставьте как есть.
MONITOR_USER=horus
MONITOR_PASSWORD=

BLACKBOX_TAG=v0.25.0
VM_TAG=v1.111.0
