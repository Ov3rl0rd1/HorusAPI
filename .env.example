# ============================================================
#  HorusAPI – environment variables
#  Copy this file to .env and fill in all values before running.
#  NEVER commit .env to version control.
# ============================================================

# ── Domain & TLS (Let's Encrypt) ─────────────────────────────
# The public domain name for this server.
# An A record must point to this machine's IP before first start.
DOMAIN=vpn.example.com

# Email used for Let's Encrypt registration and expiry alerts.
CERTBOT_EMAIL=admin@example.com

# Set to 1 to use the Let's Encrypt STAGING environment (safe for testing,
# issues untrusted certs). Switch to 0 once you confirm cert acquisition works.
CERTBOT_STAGING=0

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=horus
POSTGRES_USER=horus
POSTGRES_PASSWORD=replace-with-strong-password

# ── JWT ───────────────────────────────────────────────────────
# Minimum 64 characters. Generate with:  openssl rand -base64 64
Jwt__Secret=replace-with-min-64-char-random-secret
Jwt__Issuer=horus-auth-api
Jwt__Audience=horus-clients
Jwt__ExpiryMinutes=60

# ── Socks5 defaults embedded in rendered client configs ───────
Socks5__Port=1080
Socks5__Username=replace-me
Socks5__Password=replace-me
